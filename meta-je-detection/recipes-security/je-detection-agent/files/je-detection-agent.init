#!/bin/sh
### BEGIN INIT INFO
# Provides:          je-detection-agent
# Required-Start:    $local_fs auditd
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: JE detection agent (CVE-to-rule compensating detection)
### END INIT INFO

PIDFILE=/run/je-detection-agent.pid

case "$1" in
    start)
        echo "Starting je-detection-agent"
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
            --exec /usr/bin/je-detection-agent
        ;;
    stop)
        echo "Stopping je-detection-agent"
        start-stop-daemon --stop --pidfile "$PIDFILE" --retry 5 --oknodo
        rm -f "$PIDFILE"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
